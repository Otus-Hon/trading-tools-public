{
  "name": "trading-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ensure:sqlite": "node ./scripts/ensure_sqlite_binding.js",
    "predev": "npm run ensure:sqlite",
    "dev": "next dev",
    "predev:web": "npm run ensure:sqlite",
    "dev:web": "next dev",
    "prebuild": "npm run ensure:sqlite",
    "build": "next build --webpack",
    "prestart": "npm run ensure:sqlite",
    "start": "next start",
    "worker:public": "node ./scripts/public_data_worker.js",
    "lint": "eslint",
    "test:public-security": "node ./scripts/test_public_security.js",
    "test:windows-auto-update": "node ./scripts/test_windows_auto_update.mjs",
    "test:money-flow-seed": "node ./scripts/test_money_flow_seed.js",
    "audit:market-data": "node --env-file-if-exists=.env.local skills/audit-real-market-data/scripts/audit_market_data.js",
    "fetch": "node --env-file-if-exists=.env.local ./scripts/cbbc_fetch.js",
    "fetch:watch": "node --env-file-if-exists=.env.local ./scripts/fetch_watch.js",
    "fetch:moneyflow": "node --env-file-if-exists=.env.local ./scripts/money_flow_fetch.js",
    "fetch:moneyflow:long": "node --env-file-if-exists=.env.local ./scripts/money_flow_long_fetch.js",
    "fetch:moneyflow:short": "node --env-file-if-exists=.env.local ./scripts/money_flow_short_fetch.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.5",
    "html2canvas-pro": "^2.2.4",
    "lightweight-charts": "^5.1.0",
    "next": "^16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
